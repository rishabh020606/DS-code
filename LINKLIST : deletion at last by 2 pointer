#include <iostream>
#include <cstdlib>

using namespace std;

struct node {
    int data;
    struct node* next;
};

struct node *start = NULL;
struct node *ptr = NULL;
struct node *pptr = NULL;

int val;

void display() {
    ptr = start;
    while (ptr != NULL) {
        cout << ptr->data << "->";
        ptr = ptr->next;
    }
    cout << "NULL\n";
}

void createnode() {
    cout << "Input value to insert: ";
    cin >> val;
    struct node* newnode = (struct node*)malloc(sizeof(struct node));
    newnode->data = val;
    newnode->next = NULL;

    if (start == NULL) {
        start = newnode;
    } else {
        ptr = start;
        while (ptr->next != NULL) {
            ptr = ptr->next;
        }
        ptr->next = newnode;
    }
}

void deletelast() {
    ptr = start;
    pptr = NULL;
    while (ptr->next != NULL) {
        pptr = ptr ;
        ptr = ptr->next;
        
    }
    
   pptr->next = NULL;
}

int main() {
    int n;
    cout << "Number of nodes: ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        createnode();
    }

    cout << "\nExisting linked list is: ";
    display();

    cout << "\nNow deletion from last \n";
    deletelast();

    cout << "After deletion at last: ";
    display();

    cout << "\nFreeing remaining memory...";
    ptr = start;
    while (ptr != NULL) {
        struct node* nextnode = ptr->next;
        free(ptr);
        ptr = nextnode;
    }
    start = NULL;

    return 0;
}
